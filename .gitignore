# ============================================
# Node.js & Turborepo Monorepo .gitignore
# ============================================

# Node modules
node_modules/
**/node_modules/

# Ignore sessions folder
app_summary.md

# Build outputs
dist/
build/
out/
.next/
.vercel/
.cache/
coverage/
tmp/
temp/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
logs/
*.log

# Environment variables
.env
.env.*
**/.env
!.env.example

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Turborepo cache
.turbo/
turbo/
.cache/

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/
.nyc_output/

# Lockfiles (jika kamu ingin hanya satu lock di root)
package-lock.json
pnpm-lock.yaml
yarn.lock
apps/*/package-lock.json
apps/*/pnpm-lock.yaml
apps/*/yarn.lock
packages/*/package-lock.json
packages/*/pnpm-lock.yaml
packages/*/yarn.lock

# Build artifacts (frontend/backend)
apps/*/dist/
apps/*/.vite/
packages/*/dist/
packages/*/.vite/

# Misc
*.log
*.pid
*.seed
*.tgz
*.bak
*.old
*.orig
